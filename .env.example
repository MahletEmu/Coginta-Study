# ==============================================================
# Cognita AI Study Assistant - Local Environment Variables
# ==============================================================
# Copy this file to .env.local and populate with your credentials:
#   copy .env.example .env.local
#
# IMPORTANT:
# - Never commit .env.local or secret keys to Git repository!
# - Next.js automatically loads .env.local on the server.
# ==============================================================

# --------------------------------------------------------------
# 1. Google Gemini AI (Stage 3)
# --------------------------------------------------------------
# Obtain a free API key at: https://aistudio.google.com/app/apikey
# NEVER prefix with NEXT_PUBLIC_ (server-only key)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# (Optional) Gemini Model selection
# Default: gemini-2.5-flash (fast, economical, 1M token context)
# Alternative: gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --------------------------------------------------------------
# 2. MongoDB Database (Cluster / Cloud)
# --------------------------------------------------------------
# In MongoDB Atlas: Connect -> Drivers -> copy URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/cognita_study?retryWrites=true&w=majority
MONGODB_DB=cognita_study

# --------------------------------------------------------------
# 3. Authentication Secret
# --------------------------------------------------------------
# Any 32+ character random string for signing session cookies
AUTH_SECRET=your_production_auth_secret_key_random_string_here

# --------------------------------------------------------------
# 4. (Optional) Supabase Auth, PostgreSQL & Storage
# --------------------------------------------------------------
# Find these in your Supabase project: Settings -> API
# NEXT_PUBLIC_SUPABASE_URL: Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Client-safe publishable anonymous key
# Protected by Row Level Security (RLS) in PostgreSQL
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Optional) SUPABASE_SERVICE_ROLE_KEY: Server-only superadmin key
# NEVER prefix with NEXT_PUBLIC_! Used only for server maintenance tasks.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
